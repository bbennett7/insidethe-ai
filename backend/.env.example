# Comma-separated list of allowed origins for CORS and WebSocket connections.
# In production, set this to your frontend's deployed URL.
ALLOWED_ORIGINS=http://localhost:3000

# Set to "production" to disable Swagger UI (/docs) and ReDoc (/redoc).
# ENV=development

# Optional: HuggingFace token to avoid rate limits on model downloads.
# Only needed on first run if the model isn't cached yet.
# HF_TOKEN=hf_...
